# Copy this file to .env.local and fill in real values.
# .env.local is gitignored — never commit real keys.

# --- Phase 1: core voice loop ---

# Speech-to-text (Deepgram) — server-side key, used to mint short-lived
# browser tokens. Get one at https://console.deepgram.com
DEEPGRAM_API_KEY=

# LLM agent brain (Claude via OpenRouter) — server-side only.
# Get a key at https://openrouter.ai/keys
OPENROUTER_API_KEY=
# Model slug — check current options at https://openrouter.ai/models
OPENROUTER_MODEL=anthropic/claude-sonnet-4.5

# Text-to-speech (ElevenLabs) — server-side only.
# Get a key at https://elevenlabs.io
ELEVENLABS_API_KEY=
# A voice ID from your ElevenLabs voice library.
ELEVENLABS_VOICE_ID=

# --- Phase 2: web search tool ---

# Web search (Tavily) — server-side only, called by the LLM as a tool.
# Get a key at https://tavily.com
TAVILY_API_KEY=

# --- Later phases (not used yet, kept here so the checklist has one home) ---

# Phase 3: browser control
# STEEL_API_KEY=

# Phase 5: real-time orchestration
# LIVEKIT_API_KEY=
# LIVEKIT_API_SECRET=
# LIVEKIT_URL=
