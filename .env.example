# Copy this file to .env.local and fill in real values.
# .env.local is gitignored — never commit real keys.
#
# As of Phase 5, two processes read this file: the Next.js web app
# (`npm run dev`) and the LiveKit agent worker (`npm run agent:dev`).
# The worker loads it itself via dotenv (see agent/worker.ts) since it
# isn't a Next.js process and doesn't get .env.local for free.

# --- Real-time orchestration (LiveKit) ---

# Get these at https://cloud.livekit.io — used by both the Next.js app
# (to mint room-join tokens) and the agent worker (to connect as a
# participant). LIVEKIT_URL looks like wss://your-project.livekit.cloud
LIVEKIT_API_KEY=
LIVEKIT_API_SECRET=
LIVEKIT_URL=
# Optional — all sessions share one room by default, matching this
# project's "one personal assistant, one conversation" scope.
# LIVEKIT_ROOM_NAME=eco

# --- Speech-to-text (Deepgram) ---
# Used by the agent worker's streaming STT. Get one at
# https://console.deepgram.com
DEEPGRAM_API_KEY=

# --- LLM agent brain (Claude via OpenRouter) ---
# Get a key at https://openrouter.ai/keys
OPENROUTER_API_KEY=
# Model slug — check current options at https://openrouter.ai/models
OPENROUTER_MODEL=anthropic/claude-sonnet-4.5

# --- Text-to-speech (ElevenLabs) ---
# Get a key at https://elevenlabs.io
ELEVENLABS_API_KEY=
# A voice ID from your ElevenLabs voice library.
ELEVENLABS_VOICE_ID=

# --- Web search tool (Tavily) ---
# Called by the LLM as a tool. Get a key at https://tavily.com
TAVILY_API_KEY=

# --- Browser control tool (Steel.dev) ---
# Called by the LLM as a tool. Get a key at https://steel.dev
STEEL_API_KEY=
